<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/toolbar_background"
        android:title="@string/app_name"
        android:layout_margin="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/calificacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:contentDescription="Calificar app"
                android:src="@drawable/ic_star"
                android:foreground="@drawable/touch_effect" />

            <ImageView
                android:id="@+id/volumen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:contentDescription="Música"
                android:src="@drawable/ic_volume_up"
                android:foreground="@drawable/touch_effect"/>

            <ImageView
                android:id="@+id/instrucciones"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:contentDescription="Explicación del juego"
                android:src="@drawable/ic_explication"
                android:foreground="@drawable/touch_effect" />

            <ImageView
                android:id="@+id/agregar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:contentDescription="Agregar reto"
                android:src="@drawable/ic_add_reto"
                android:foreground="@drawable/touch_effect" />

            <ImageView
                android:id="@+id/compartir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Compartir"
                android:src="@drawable/ic_share"
                android:layout_marginEnd="10dp"
                android:foreground="@drawable/touch_effect" />

            <ImageView
                android:id="@+id/salir"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="Salir"
                android:src="@drawable/ic_logout"
                android:foreground="@drawable/touch_effect" />

        </LinearLayout>
    </androidx.appcompat.widget.Toolbar>

</RelativeLayout>
